# --- Evolution API ---
# No Docker local pode deixar assim (o docker-compose sobrescreve).
EVOLUTION_API_URL=https://sua-evolution.exemplo.com
# No Docker local: invente uma senha; ela vira a chave global da sua Evolution.
EVOLUTION_API_KEY=sua-apikey-da-instancia-ou-global
EVOLUTION_INSTANCE=bob

# Token secreto que vai na URL do webhook: https://seu-app.vercel.app/api/webhook?token=ESTE_VALOR
WEBHOOK_TOKEN=troque-por-um-valor-aleatorio-grande

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=sua-chave-gemini
# Opcional: sem ela o Bob usa gemini-3.8-flash. Só defina se quiser outro modelo.
# GEMINI_MODEL=gemini-3.8-flash
# Opcional: modelos reserva (separados por vírgula) quando o principal estiver sobrecarregado.
# Padrão: gemini-3.1-flash-lite. Deixe vazio para desligar.
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- Opcional ---
# Números autorizados (só dígitos, separados por vírgula). Vazio = qualquer um pode usar.
ALLOWED_NUMBERS=5511999999999
TIMEZONE=America/Sao_Paulo

# Opcional: JID(s) de grupo (ex.: 120363000000000000@g.us). Se preenchido, o Bob responde SÓ nesses grupos
# (ignora o privado) e qualquer membro do grupo pode usar.
ALLOWED_GROUPS=
# "grupo" (padrão): uma conta só para o grupo todo. "pessoa": cada membro tem a sua conta.
GROUP_LEDGER=grupo
